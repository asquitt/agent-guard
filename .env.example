# AgentGuard Environment Variables

# Database
DATABASE_URL=postgresql://agentguard:agentguard@localhost:5432/agentguard

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
DEBUG=true
APP_NAME=AgentGuard
API_PREFIX=/api/v1

# LLM Providers (for proxy)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Alerting
SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=

# Sentry (optional)
SENTRY_DSN=
